generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  phone        String?
  role         String   @default("CUSTOMER")
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookingsCreated   Booking[]          @relation("CreatedBy")
  housekeepingTasks HousekeepingTask[] @relation("AssignedTo")

  @@index([role])
  @@index([status])
}

model Customer {
  id             String    @id @default(cuid())
  fullName       String
  phone          String?
  email          String?   @unique
  identityNumber String?
  nationality    String?
  address        String?
  dateOfBirth    DateTime?
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  bookings Booking[]

  @@index([phone])
}

model RoomType {
  id             String   @id @default(cuid())
  name           String   @unique
  slug           String?  @unique
  description    String?
  pricePerNight  Int
  pricePerHour   Int      @default(0)
  overnightPrice Int      @default(0)
  maxGuests      Int
  bedCount       Int
  area           Float?
  amenities      String?
  imageUrl       String?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rooms    Room[]
  bookings Booking[]
}

model Room {
  id         String   @id @default(cuid())
  roomNumber String   @unique
  floor      Int
  roomTypeId String
  status     String   @default("AVAILABLE")
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  roomType          RoomType           @relation(fields: [roomTypeId], references: [id])
  bookings          Booking[]
  housekeepingTasks HousekeepingTask[]

  @@index([status])
  @@index([roomTypeId])
  @@index([floor])
}

model Booking {
  id                  String    @id @default(cuid())
  bookingCode         String    @unique
  customerId          String
  roomId              String?
  roomTypeId          String
  checkInDate         DateTime
  checkOutDate        DateTime
  actualCheckIn       DateTime?
  actualCheckOut      DateTime?
  status              String    @default("PENDING")
  bookingType         String    @default("NIGHTLY")
  hours               Float?
  numberOfGuests      Int       @default(1)
  depositAmount       Int       @default(0)
  nightlyRateSnapshot Int?
  voucherCode         String?
  discountAmount      Int       @default(0)
  taxAmount           Int       @default(0)
  totalAmount         Int       @default(0)
  specialRequests     String?
  cancellationReason  String?
  cancelledAt         DateTime?
  cancelledByUserId   String?
  note                String?
  createdById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  customer        Customer         @relation(fields: [customerId], references: [id])
  room            Room?            @relation(fields: [roomId], references: [id])
  roomType        RoomType         @relation(fields: [roomTypeId], references: [id])
  createdBy       User?            @relation("CreatedBy", fields: [createdById], references: [id])
  bookingServices BookingService[]
  invoices        Invoice[]

  @@index([checkInDate, checkOutDate])
  @@index([status])
  @@index([customerId])
  @@index([roomTypeId])
}

model Service {
  id          String   @id @default(cuid())
  name        String
  price       Int
  unit        String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookingServices BookingService[]

  @@index([status])
}

model BookingService {
  id          String   @id @default(cuid())
  bookingId   String
  serviceId   String
  quantity    Int      @default(1)
  priceAtTime Int
  totalAmount Int
  createdAt   DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@index([bookingId])
}

model Invoice {
  id              String   @id @default(cuid())
  invoiceCode     String   @unique
  bookingId       String   @unique
  roomAmount      Int      @default(0)
  serviceAmount   Int      @default(0)
  surchargeAmount Int      @default(0)
  discountAmount  Int      @default(0)
  taxAmount       Int      @default(0)
  totalAmount     Int      @default(0)
  paidAmount      Int      @default(0)
  paymentStatus   String   @default("UNPAID")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  booking  Booking   @relation(fields: [bookingId], references: [id])
  payments Payment[]

  @@index([paymentStatus])
  @@index([bookingId])
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Int
  method    String   @default("CASH")
  paidAt    DateTime @default(now())
  note      String?

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

model HousekeepingTask {
  id           String    @id @default(cuid())
  roomId       String
  assignedToId String?
  status       String    @default("PENDING")
  note         String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  room       Room  @relation(fields: [roomId], references: [id])
  assignedTo User? @relation("AssignedTo", fields: [assignedToId], references: [id])

  @@index([status])
}

model PricingConfig {
  id             String   @id @default(cuid())
  name           String   @unique
  overnightStart String   @default("23:00")
  overnightEnd   String   @default("11:00")
  gracePeriod    Int      @default(15)
  overtimeCharge Int      @default(30)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userRole  String?
  action    String
  entity    String
  entityId  String?
  detail    String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

model Voucher {
  id             String    @id @default(cuid())
  code           String    @unique
  description    String?
  discountType   String    @default("PERCENT")
  discountAmount Int
  minOrderAmount Int       @default(0)
  maxDiscount    Int?
  maxUses        Int       @default(100)
  usedCount      Int       @default(0)
  validFrom      DateTime  @default(now())
  validUntil     DateTime
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([code])
  @@index([status])
}
